<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- The one file the build reads. Order does not matter.

	     Every element takes if="..." and unless="...", and these are the whole vocabulary:

	       windows, linux, mac    the operating system being built on
	       desktop                all of them, and the form factor a build is for
	       debug, release         the kind of build
	       msvc, clang-cl, mingw  a toolchain on Windows
	       clang, gcc             a toolchain everywhere else
	       llvm                   clang-cl, clang or mingw, whichever of them is in hand

	     A toolchain name is never a target. if="mingw" on a link says how a library is named
	     to the mingw linker, not that there is a mingw build to produce; the targets are the
	     <target> elements and nothing else names them.

	     Never call this project.xml, Project.xml, project.hxp or project.lime: any of the four
	     makes the Lime editor extension claim the workspace, and completion dies silently. -->


	<!-- application -->

	<meta title="MD Synth DAW" short="mdd" version="0.1.0"
		company="md-synth-daw"
		description="A hardware-aware DAW for the Sega Mega Drive" />

	<window width="1440" height="900" least-width="960" least-height="600"
		vsync="true" resizable="true" high-dpi="true" />

	<format suffix="mdsyn" name="MD Synth Project File" mime="application/x-mdsyn" />

	<update github="MeguminBOT/md-synth-daw" />

	<presence discord="1546264890317086730" cover="cover"
		playing="playing" stopped="stopped" working="working" />


	<!-- build -->

	<toolchains>
		<toolchain name="clang-cl" if="windows" probe="clang-cl"
			about="LLVM against the Microsoft ABI, linked by the Microsoft linker" />
		<toolchain name="msvc" if="windows"
			about="the Microsoft compiler and linker" />
		<toolchain name="mingw" if="windows" probe="none"
			about="LLVM or GCC against the mingw-w64 ABI, with no crash report" />

		<toolchain name="clang" unless="windows" probe="clang++" about="LLVM" />
		<toolchain name="gcc" unless="windows" about="GCC" />
	</toolchains>

	<source path="src" />
	<generated path="export/haxe" />
	<output path="export" />

	<target id="mdd" main="mdd.App" />

	<target id="gate" main="mdd.gate.Gate">
		<source path="test" />
	</target>

	<library name="hxcpp-debug-server" if="debug" />

	<define name="windows" if="windows" />
	<define name="linux" if="linux" />
	<define name="mac" if="mac" />
	<define name="desktop" />

	<define name="analyzer-optimize" />
	<define name="HXCPP_OPTIMIZE_LINK" />
	<define name="HXCPP_GC_GENERATIONAL" />
	<define name="HXCPP_M64" />
	<define name="HXCPP_CHECK_POINTER" if="debug" />
	<define name="HXCPP_STACK_LINE" if="debug" />
	<define name="HXCPP_DEBUG_LINK" />


	<!-- sources -->

	<vendor name="SDL3" present="SDL3/include/SDL3/SDL.h" system="/usr/include/SDL3/SDL.h"
		size="12 MB"
		about="the window and its events, called directly. A system package off Windows" />
	<vendor name="miniaudio" present="miniaudio/miniaudio.h" size="1 MB"
		about="the audio device, called directly" />
	<vendor name="stb" present="stb/stb_truetype.h" size="1 MB"
		about="the glyph rasteriser the font atlas is baked with" />
	<vendor name="fonts" present="fonts/Go-Regular.ttf" size="40 MB"
		about="the interface faces, and the CJK faces a glyph is cut from when one has none" />
	<vendor name="libogg" present="libogg/src/framing.c" size="1 MB"
		about="the ogg container, the pages an ogg vorbis or opus file is made of" />
	<vendor name="libvorbis" present="libvorbis/lib/vorbisenc.c" size="5 MB"
		about="the ogg vorbis encoder" />
	<vendor name="libopus" present="libopus/src/opus_encoder.c" size="30 MB"
		about="the opus encoder" />

	<vendor name="qlementine" present="qlementine/16/instrument/piano.svg" size="1 MB"
		about="the interface icons, rasterised into an atlas at build time" />

	<vendor name="Nuked-OPN2" present="Nuked-OPN2/ym3438.c" size="1 MB" flag="nuked"
		about="a known-good YM2612 the FM core is measured against, built as a program of its own" />

	<path name="SDL3PATH" value="vendor/SDL3" />
	<path name="MINIAUDIOPATH" value="vendor/miniaudio" />
	<path name="STBPATH" value="vendor/stb" />
	<path name="FONTPATH" value="vendor/fonts" />
	<path name="NATIVEPATH" value="src/mdd/native" />
	<path name="OPN2PATH" value="vendor/Nuked-OPN2" />
	<path name="OGGPATH" value="vendor/libogg" />
	<path name="VORBISPATH" value="vendor/libvorbis" />
	<path name="OPUSPATH" value="vendor/libopus" />

	<native path="src/mdd/native">
		<file name="window.cpp" />
		<file name="events.cpp" />
		<file name="draw.cpp" />
		<file name="text.cpp" />
		<file name="audio.cpp" />
		<file name="dialog.cpp" />
		<file name="instance.cpp" />
		<file name="crash.cpp" />
		<file name="usage.cpp" />
		<file name="midi.cpp" />
		<file name="discord.cpp" />
		<file name="encode.cpp" />
		<file name="shell.cpp" />

		<flag value="-DOPUS_BUILD" />
		<flag value="-DUSE_ALLOCA" />
		<flag value="-DOPUS_HAVE_RTCD=0" />
		<flag value="-D_CRT_SECURE_NO_WARNINGS" />

		<tree path="vendor/libogg/src" suffix=".c" />

		<!-- its own quote-includes need lib on the path, and it is kept off the shared list
		     because libopus declares mdct_lookup as well -->

		<tree path="vendor/libvorbis/lib" suffix=".c"
			skip="barkmel,misc,psytune,tone,vorbisfile" include="vendor/libvorbis/lib" />
		<tree path="vendor/libopus/celt" suffix=".c" skip="opus_custom_demo" />
		<tree path="vendor/libopus/silk" suffix=".c" />
		<tree path="vendor/libopus/silk/float" suffix=".c" />
		<tree path="vendor/libopus/src" suffix=".c"
			skip="opus_compare,opus_demo,repacketizer_demo" />
	</native>

	<include value="${SDL3PATH}/include" if="windows" />
	<include value="${MINIAUDIOPATH}" />
	<include value="${STBPATH}" />
	<include value="${NATIVEPATH}" />
	<include value="${OGGPATH}/include" />
	<include value="${VORBISPATH}/include" />
	<include value="${OPUSPATH}/include" />
	<include value="${OPUSPATH}/celt" />
	<include value="${OPUSPATH}/silk" />
	<include value="${OPUSPATH}/silk/float" />

	<!-- the window's library, however each linker wants to be told about it -->

	<link value="${SDL3PATH}/lib/SDL3.lib" if="windows" unless="mingw" />
	<link value="${SDL3PATH}/lib/SDL3.dll" if="mingw" />
	<link value="-lSDL3" unless="windows" />

	<!-- what Windows itself supplies: the crash report reads dbghelp, the scheduler tick
	     comes from winmm, and the usage readout from psapi and pdh. The Microsoft linker
	     takes a file name and the mingw one takes a -l switch, so each is written twice -->

	<link value="dbghelp.lib" if="windows" unless="mingw" />
	<link value="winmm.lib" if="windows" unless="mingw" />
	<link value="psapi.lib" if="windows" unless="mingw" />
	<link value="pdh.lib" if="windows" unless="mingw" />
	<link value="advapi32.lib" if="windows" unless="mingw" />
	<link value="shell32.lib" if="windows" unless="mingw" />

	<link value="-ldbghelp" if="mingw" />
	<link value="-lwinmm" if="mingw" />
	<link value="-lpsapi" if="mingw" />
	<link value="-lpdh" if="mingw" />
	<link value="-ladvapi32" if="mingw" />
	<link value="-lshell32" if="mingw" />

	<!-- what Linux supplies -->

	<link value="-lm" if="linux" />
	<link value="-ldl" if="linux" />
	<link value="-lpthread" if="linux" />

	<!-- what macOS supplies, as frameworks -->

	<link value="-framework CoreFoundation" if="mac" />
	<link value="-framework CoreAudio" if="mac" />
	<link value="-framework AudioToolbox" if="mac" />

	<ship value="vendor/SDL3/lib/SDL3.dll" if="windows" />


	<!-- assets -->

	<languages path="assets/lang" />
	<appicon path="assets/icon" />

	<typefaces path="vendor/fonts">
		<face name="Go-Regular.ttf" from="go:Go-Regular.ttf" />
		<face name="Go-Mono.ttf" from="go:Go-Mono.ttf" />
		<face name="IBMPlexSans.ttf" from="ofl:ibmplexsans/IBMPlexSans[wdth,wght].ttf" />

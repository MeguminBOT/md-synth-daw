		<face name="Inter.ttf" from="ofl:inter/Inter[opsz,wght].ttf" />
		<face name="JetBrainsMono.ttf" from="ofl:jetbrainsmono/JetBrainsMono[wght].ttf" />
		<face name="BarlowSemiCondensed.ttf" from="ofl:barlowsemicondensed/BarlowSemiCondensed-Regular.ttf" />
		<face name="SourceSans3.ttf" from="ofl:sourcesans3/SourceSans3[wght].ttf" />
		<face name="SourceCodePro.ttf" from="ofl:sourcecodepro/SourceCodePro[wght].ttf" />
		<face name="NotoSans.ttf" from="ofl:notosans/NotoSans[wdth,wght].ttf" />
		<face name="NotoSansMono.ttf" from="ofl:notosansmono/NotoSansMono[wdth,wght].ttf" />
		<face name="FiraSans.ttf" from="ofl:firasans/FiraSans-Regular.ttf" />
		<face name="FiraCode.ttf" from="ofl:firacode/FiraCode[wght].ttf" />
		<face name="WorkSans.ttf" from="ofl:worksans/WorkSans[wght].ttf" />
		<face name="RobotoMono.ttf" from="ofl:robotomono/RobotoMono[wght].ttf" />
		<face name="OpenSans.ttf" from="ofl:opensans/OpenSans[wdth,wght].ttf" />

		<face name="NotoSansJP.ttf" from="ofl:notosansjp/NotoSansJP[wght].ttf" />
		<face name="NotoSansSC.ttf" from="ofl:notosanssc/NotoSansSC[wght].ttf" />
		<face name="NotoSansKR.ttf" from="ofl:notosanskr/NotoSansKR[wght].ttf" />

		<fallback name="NotoSans.ttf" />
		<fallback name="NotoSansJP.ttf" />
		<fallback name="NotoSansSC.ttf" />
		<fallback name="NotoSansKR.ttf" />

		<typeface name="Go" sans="Go-Regular.ttf" mono="Go-Mono.ttf" />
		<typeface name="IBM Plex" sans="IBMPlexSans.ttf" mono="IBMPlexMono.ttf" />
		<typeface name="Inter" sans="Inter.ttf" mono="JetBrainsMono.ttf" />
		<typeface name="Barlow" sans="BarlowSemiCondensed.ttf" mono="IBMPlexMono.ttf" />
		<typeface name="Source" sans="SourceSans3.ttf" mono="SourceCodePro.ttf" />
		<typeface name="Noto" sans="NotoSans.ttf" mono="NotoSansMono.ttf" />
		<typeface name="Fira" sans="FiraSans.ttf" mono="FiraCode.ttf" />
		<typeface name="Work Sans" sans="WorkSans.ttf" mono="RobotoMono.ttf" />
		<typeface name="Open Sans" sans="OpenSans.ttf" mono="RobotoMono.ttf" />
	</typefaces>

	<!-- numbered in the order below, and a saved project refers to the number: add at the end,
	     and change a from rather than a name when artwork is replaced -->


<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- The one file the build reads. Order does not matter.

	     Every element takes if="..." and unless="...", and these are the whole vocabulary:

	       windows, linux, mac    the operating system being built on
	       desktop                all of them, and the form factor a build is for
	       debug, release         the kind of build
	       msvc, clang-cl, mingw  a toolchain on Windows
	       clang, gcc             a toolchain everywhere else
	       llvm                   clang-cl, clang or mingw, whichever of them is in hand

	     A toolchain name is never a target. if="mingw" on a link says how a library is named
	     to the mingw linker, not that there is a mingw build to produce; the targets are the
	     <target> elements and nothing else names them.

	     Never call this project.xml, Project.xml, project.hxp or project.lime: any of the four
	     makes the Lime editor extension claim the workspace, and completion dies silently. -->


	<!-- application -->

	<meta title="MD Synth DAW" short="mdd" version="0.2.0"
		company="md-synth-daw"
		description="A hardware-aware DAW for the Sega Mega Drive" />

	<window width="1440" height="900" least-width="960" least-height="600"
		vsync="true" resizable="true" high-dpi="true" />

	<format suffix="mdsyn" name="MD Synth Project File" mime="application/x-mdsyn" />

	<update github="MeguminBOT/md-synth-daw" />

	<presence discord="1546264890317086730" cover="cover"
		playing="playing" stopped="stopped" working="working" />


	<!-- build -->

	<toolchains>
		<toolchain name="clang-cl" if="windows" probe="clang-cl"
			about="LLVM against the Microsoft ABI, linked by the Microsoft linker" />
		<toolchain name="msvc" if="windows"
			about="the Microsoft compiler and linker" />
		<toolchain name="mingw" if="windows" probe="none"
			about="LLVM or GCC against the mingw-w64 ABI, reading its own symbols and DWARF" />

		<toolchain name="clang" unless="windows" probe="clang++" about="LLVM" />
		<toolchain name="gcc" unless="windows" about="GCC" />
	</toolchains>

	<source path="src" />
	<generated path="export/haxe" />
	<output path="export" />

	<target id="mdd" main="mdd.App" />

	<target id="gate" main="mdd.gate.Gate">
		<source path="test" />
	</target>

	<library name="hxcpp-debug-server" if="debug" />

	<dce value="full" unless="debug" />

	<define name="windows" if="windows" />
	<define name="linux" if="linux" />
	<define name="mac" if="mac" />
	<define name="desktop" />

	<define name="analyzer-optimize" />
	<define name="HXCPP_OPTIMIZE_LINK" />
	<define name="HXCPP_GC_GENERATIONAL" />
	<define name="HXCPP_M64" if="x86_64" />
	<define name="HXCPP_ARM64" if="arm64" />
	<define name="HXCPP_CHECK_POINTER" if="debug" />
	<define name="HXCPP_STACK_LINE" if="debug" />
	<define name="HXCPP_DEBUG_LINK" />


	<!-- sources -->

	<vendor name="SDL3" present="SDL3/include/SDL3/SDL.h"
		system="/usr/include/SDL3/SDL.h,/opt/homebrew/include/SDL3/SDL.h,/usr/local/include/SDL3/SDL.h"
		size="12 MB"
		about="the window and its events, called directly. A system package off Windows" />
	<vendor name="miniaudio" present="miniaudio/miniaudio.h" size="1 MB"
		about="the audio device, called directly" />
	<vendor name="stb" present="stb/stb_truetype.h" size="1 MB"
		about="the glyph rasteriser the font atlas is baked with" />
	<vendor name="fonts" present="fonts/Go-Regular.ttf" size="40 MB"
		about="the interface faces, and the CJK faces a glyph is cut from when one has none" />
	<vendor name="libogg" present="libogg/src/framing.c" size="1 MB"
		about="the ogg container, the pages an ogg vorbis or opus file is made of" />
	<vendor name="libvorbis" present="libvorbis/lib/vorbisenc.c" size="5 MB"
		about="the ogg vorbis encoder" />
	<vendor name="libopus" present="libopus/src/opus_encoder.c" size="30 MB"
		about="the opus encoder" />

	<vendor name="qlementine" present="qlementine/16/instrument/piano.svg" size="1 MB"
		about="the interface icons, rasterised into an atlas at build time" />

	<vendor name="Nuked-OPN2" present="Nuked-OPN2/ym3438.c" size="1 MB" flag="nuked"
		about="a known-good YM2612 the FM core is measured against, built as a program of its own" />

	<path name="SDL3PATH" value="vendor/SDL3" />
	<path name="MINIAUDIOPATH" value="vendor/miniaudio" />
	<path name="STBPATH" value="vendor/stb" />
	<path name="FONTPATH" value="vendor/fonts" />
	<path name="NATIVEPATH" value="src/mdd/native" />
	<path name="OPN2PATH" value="vendor/Nuked-OPN2" />
	<path name="OGGPATH" value="vendor/libogg" />
	<path name="VORBISPATH" value="vendor/libvorbis" />
	<path name="OPUSPATH" value="vendor/libopus" />

	<native path="src/mdd/native">
		<file name="window.cpp" />
		<file name="events.cpp" />
		<file name="draw.cpp" />
		<file name="text.cpp" />
		<file name="vary.cpp" />
		<file name="audio.cpp" />
		<file name="dialog.cpp" />
		<file name="instance.cpp" />
		<file name="crash.cpp" />
		<file name="usage.cpp" />
		<file name="midi.cpp" />
		<file name="discord.cpp" />
		<file name="encode.cpp" />
		<file name="shell.cpp" />

		<flag value="-DOPUS_BUILD" />
		<flag value="-DUSE_ALLOCA" />
		<flag value="-DOPUS_HAVE_RTCD=0" />
		<flag value="-DHAVE_LRINTF" />
		<flag value="-D_CRT_SECURE_NO_WARNINGS" />
		<flag value="-Wno-unused-command-line-argument" unless="msvc" />

		<tree path="vendor/libogg/src" suffix=".c" />

		<!-- its own quote-includes need lib on the path, and it is kept off the shared list
		     because libopus declares mdct_lookup as well -->

		<tree path="vendor/libvorbis/lib" suffix=".c"
			skip="barkmel,misc,psytune,tone,vorbisfile" include="vendor/libvorbis/lib" />
		<tree path="vendor/libopus/celt" suffix=".c" skip="opus_custom_demo" />
		<tree path="vendor/libopus/silk" suffix=".c" />
		<tree path="vendor/libopus/silk/float" suffix=".c" />
		<tree path="vendor/libopus/src" suffix=".c"
			skip="opus_compare,opus_demo,repacketizer_demo" />
	</native>

	<include value="${SDL3PATH}/include" if="windows" />

	<!-- homebrew is /opt/homebrew on apple silicon and /usr/local on intel, and
	     clang searches neither by default. A path that is not there costs nothing.
	     Linux needs none of this: apt puts SDL3 where the compiler already looks. -->
	<include value="/opt/homebrew/include" if="mac" />
	<include value="/usr/local/include" if="mac" />
	<include value="${MINIAUDIOPATH}" />
	<include value="${STBPATH}" />
	<include value="${NATIVEPATH}" />
	<include value="${OGGPATH}/include" />
	<include value="${VORBISPATH}/include" />
	<include value="${OPUSPATH}/include" />
	<include value="${OPUSPATH}/celt" />
	<include value="${OPUSPATH}/silk" />
	<include value="${OPUSPATH}/silk/float" />

	<!-- /DEBUG turns REF off and the crash report wants the symbols, so the pass that drops
	     what nothing calls is asked for again: it takes the binary from 8225280 bytes to
	     5350912. ICF stays off. LTCG has already folded what it would fold, so it saves
	     nothing here, and it would leave a stack trace naming whichever of two identical
	     functions the linker happened to keep -->

	<compileflag value="-Wno-parentheses-equality" unless="msvc" />

	<linkflag value="-OPT:REF" if="windows" unless="mingw,debug" />

	<!-- look beside the binary for the copy of SDL3 the packaging carries there -->
	<linkflag value="-Wl,-rpath,$ORIGIN" if="linux" />

	<!-- hxcpp compiles every Linux object with -flto when HXCPP_OPTIMIZE_LINK is defined, and
	     links with the compiler and nothing more. A clang object is then LLVM bitcode, which the
	     system ld cannot read at all, so clang links with lld, which reads it natively. A GCC
	     object is GIMPLE, which only GCC reads, so the link has to be told it is an LTO link
	     too. macOS is left out: its linker reads bitcode already -->
	<linkflag value="-flto" if="linux" unless="debug" />
	<linkflag value="-fuse-ld=lld" if="clang" unless="mac" />

	<!-- mingw carries its symbols inside the binary where the Microsoft linker puts them in a
	     pdb beside it, and it is told not to strip because the crash report reads them back.
	     The report reads the symbol table and the line table and opens none of the rest, which
	     is 79 per cent of the file: a release sheds it and reports the same stack. A debug
	     build keeps the lot, because a debugger wants what a crash report does not -->

	<strip sections=".debug_info,.debug_loc,.debug_str,.debug_ranges,.debug_abbrev,.debug_aranges"
		if="mingw" unless="debug" />

	<!-- the window's library, however each linker wants to be told about it -->

	<link value="${SDL3PATH}/lib/SDL3.lib" if="windows" unless="mingw" />
	<link value="${SDL3PATH}/lib/SDL3.dll" if="mingw" />
	<link value="-L/opt/homebrew/lib" if="mac" />
	<link value="-L/usr/local/lib" if="mac" />
	<link value="-lSDL3" unless="windows" />

	<!-- what Windows itself supplies: the crash report reads dbghelp, the scheduler tick
	     comes from winmm, and the usage readout from psapi and pdh. The Microsoft linker
	     takes a file name and the mingw one takes a -l switch, so each is written twice -->

	<link value="dbghelp.lib" if="windows" unless="mingw" />
	<link value="winmm.lib" if="windows" unless="mingw" />
	<link value="psapi.lib" if="windows" unless="mingw" />
	<link value="pdh.lib" if="windows" unless="mingw" />
	<link value="advapi32.lib" if="windows" unless="mingw" />
	<link value="shell32.lib" if="windows" unless="mingw" />
	<link value="ole32.lib" if="windows" unless="mingw" />
	<link value="uuid.lib" if="windows" unless="mingw" />

	<link value="-ldbghelp" if="mingw" />
	<link value="-lwinmm" if="mingw" />
	<link value="-lpsapi" if="mingw" />
	<link value="-lpdh" if="mingw" />
	<link value="-ladvapi32" if="mingw" />
	<link value="-lshell32" if="mingw" />
	<link value="-lole32" if="mingw" />
	<link value="-luuid" if="mingw" />

	<!-- what Linux supplies -->

	<link value="-lm" if="linux" />
	<link value="-ldl" if="linux" />
	<link value="-lpthread" if="linux" />

	<!-- what macOS supplies, as frameworks -->

	<link value="-framework CoreFoundation" if="mac" />
	<link value="-framework CoreAudio" if="mac" />
	<link value="-framework AudioToolbox" if="mac" />

	<ship value="vendor/SDL3/lib/SDL3.dll" if="windows" />

	<!--
		Windows links the vendored SDL3 and ships the DLL beside the binary. macOS and Linux
		link whatever the package manager installed, so the binary comes out naming an
		absolute path no other machine has, and the build carries that library into
		export/bin the same way.
	-->
	<carry value="libSDL3" unless="windows" />


	<!-- assets -->

	<languages path="assets/lang" />
	<appicon path="assets/icon" />

	<typefaces path="vendor/fonts">
		<face name="Go-Regular.ttf" from="go:Go-Regular.ttf" />
		<face name="Go-Mono.ttf" from="go:Go-Mono.ttf" />
		<face name="IBMPlexSans.ttf" from="ofl:ibmplexsans/IBMPlexSans[wdth,wght].ttf" />
		<face name="IBMPlexMono.ttf" from="ofl:ibmplexmono/IBMPlexMono-Regular.ttf" />
		<face name="Inter.ttf" from="ofl:inter/Inter[opsz,wght].ttf" />
		<face name="JetBrainsMono.ttf" from="ofl:jetbrainsmono/JetBrainsMono[wght].ttf" />
		<face name="BarlowSemiCondensed.ttf" from="ofl:barlowsemicondensed/BarlowSemiCondensed-Regular.ttf" />
		<face name="SourceSans3.ttf" from="ofl:sourcesans3/SourceSans3[wght].ttf" />
		<face name="SourceCodePro.ttf" from="ofl:sourcecodepro/SourceCodePro[wght].ttf" />
		<face name="NotoSans.ttf" from="ofl:notosans/NotoSans[wdth,wght].ttf" />
		<face name="NotoSansMono.ttf" from="ofl:notosansmono/NotoSansMono[wdth,wght].ttf" />
		<face name="FiraSans.ttf" from="ofl:firasans/FiraSans-Regular.ttf" />
		<face name="FiraCode.ttf" from="ofl:firacode/FiraCode[wght].ttf" />
		<face name="WorkSans.ttf" from="ofl:worksans/WorkSans[wght].ttf" />
		<face name="RobotoMono.ttf" from="ofl:robotomono/RobotoMono[wght].ttf" />
		<face name="OpenSans.ttf" from="ofl:opensans/OpenSans[wdth,wght].ttf" />

		<face name="NotoSansJP.ttf" from="ofl:notosansjp/NotoSansJP[wght].ttf" />
		<face name="NotoSansSC.ttf" from="ofl:notosanssc/NotoSansSC[wght].ttf" />
		<face name="NotoSansKR.ttf" from="ofl:notosanskr/NotoSansKR[wght].ttf" />

		<fallback name="NotoSans.ttf" />
		<fallback name="NotoSansJP.ttf" />
		<fallback name="NotoSansSC.ttf" />
		<fallback name="NotoSansKR.ttf" />

		<condensed name="BarlowSemiCondensed.ttf" />

		<typeface name="Go" sans="Go-Regular.ttf" mono="Go-Mono.ttf" />
		<typeface name="IBM Plex" sans="IBMPlexSans.ttf" mono="IBMPlexMono.ttf" />
		<typeface name="Inter" sans="Inter.ttf" mono="JetBrainsMono.ttf" />
		<typeface name="Barlow" sans="BarlowSemiCondensed.ttf" mono="IBMPlexMono.ttf" />
		<typeface name="Source" sans="SourceSans3.ttf" mono="SourceCodePro.ttf" />
		<typeface name="Noto" sans="NotoSans.ttf" mono="NotoSansMono.ttf" />
		<typeface name="Fira" sans="FiraSans.ttf" mono="FiraCode.ttf" />
		<typeface name="Work Sans" sans="WorkSans.ttf" mono="RobotoMono.ttf" />
		<typeface name="Open Sans" sans="OpenSans.ttf" mono="RobotoMono.ttf" />
	</typefaces>

	<!-- numbered in the order below, and a saved project refers to the number: add at the end,
	     and change a from rather than a name when artwork is replaced -->

	<icons path="assets/icons" sizes="16,18,20,22,24,26,28,32,36,40,48,64">
		<from name="qlementine" path="vendor/qlementine/16" />
		<group name="shape">
			<icon name="dot" from="qlementine:shape/circle-filled" />
			<icon name="ring" from="qlementine:shape/circle" />
			<icon name="square" from="qlementine:shape/square-filled" />
			<icon name="square-hollow" from="qlementine:shape/square" />
			<icon name="diamond" from="qlementine:shape/diamond-filled" />
			<icon name="triangle" from="qlementine:shape/triangle-filled" />
			<icon name="star" from="qlementine:shape/star-filled" />
			<icon name="cross" from="qlementine:shape/cross" />
			<icon name="tick" from="qlementine:shape/check-tick" />
		</group>
		<group name="audio">
			<icon from="qlementine:audio" names="wave-sine,wave-square,wave-triangle" />
			<icon name="wave-saw" from="wave-saw" />
			<icon name="wave-noise" from="wave-noise" />
			<icon name="eq" from="qlementine:audio/eq-flat" />
			<icon name="speaker" from="qlementine:audio/speaker-2" />
			<icon name="buffer" from="qlementine:audio/buffer" />
			<icon name="note" from="qlementine:misc/note-8th-simple" />
			<icon from="qlementine:misc" names="notes,bell" />
			<icon from="qlementine:hardware" names="headphones,microphone" />
		</group>
		<group name="instrument">
			<icon from="qlementine:instrument" names="piano,synthesizer,guitar,guitar-folk,guitar-classical,
				guitar-strat,guitar-tele,guitar-jackson,guitar-12-strings,bass,ukulele,banjo,mandolin,sitar,
				shamisen,harp,violin,cello,accordion,harmonica,saxophone,trumpet,trombone,tuba,woodwind,pipe,
				amp,pedal,pedalboard,drumkit,kick,snare,tom,hi-hat,cymbal,cowbell,bongos,tambourine,shakers,
				clap,drumsticks,drum-brushes,idiophone,tamtam,mastering" />
		</group>
	</icons>

</project>
